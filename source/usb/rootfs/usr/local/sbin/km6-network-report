#!/bin/sh
# Collect evidence automatically; never change the network or install modules.
set -u
[ "$(id -u)" = 0 ] || exit 1
[ "$(findmnt -n -o FSTYPE --target /boot)" = vfat ] || {
    echo 'KM6: FAT boot partition unavailable; see the system journal.'
    exit 1
}
elapsed=0
while [ "$elapsed" -lt 45 ]; do
    if ip -4 -o address show dev eth0 scope global | grep -q ' inet '; then
        break
    fi
    sleep 1
    elapsed=$((elapsed + 1))
done
report=/boot/km6-network-report.txt
temp="$report.tmp"
(
    echo 'KM6 Ethernet startup report, image revision autoload-v2'
    date -Is
    uname -a
    echo '--- Driver configuration and loaded modules ---'
    cat /etc/modules-load.d/km6-maxio.conf
    grep -E '^(km6_maxio|maxio) ' /proc/modules || true
    echo '--- PHY ---'
    for phy in /sys/bus/mdio_bus/devices/*; do
        [ -f "$phy/phy_id" ] || continue
        echo "$phy"
        cat "$phy/phy_id"
        readlink "$phy/driver" || true
    done
    echo '--- Network ---'
    ip -br link
    ip -br address
    ip route
    timeout 10 networkctl status eth0 --no-pager || true
    echo '--- Failed units ---'
    systemctl --failed --no-pager || true
    echo '--- Startup units ---'
    journalctl -b --no-pager -u systemd-modules-load.service -u systemd-networkd.service
    echo '--- Kernel ---'
    dmesg
) > "$temp" 2>&1
mv "$temp" "$report"
sync -f /boot
address=$(ip -4 -o address show dev eth0 scope global | awk '{print $4}')
if [ -n "$address" ]; then
    echo "KM6: Ethernet address $address; diagnostic report saved to $report"
else
    echo "KM6: no Ethernet IPv4 address yet; diagnostic report saved to $report"
fi
