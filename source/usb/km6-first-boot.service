[Unit]
Description=Set fresh KM6 credentials on the HDMI console
After=local-fs.target
Before=lightdm.service ssh.service getty@tty1.service
ConditionPathExists=!/var/lib/km6-first-boot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/km6-first-boot
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
